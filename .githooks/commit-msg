#!/bin/sh
# Requires the first line of the commit message to look like
#   type: subject            e.g. "fix: keep the lobby alive"
#   type(scope): subject     e.g. "fix(lobby): keep the lobby alive"
# Messages generated by git (merges, reverts, fixup!/squash!) are allowed.
first=$(grep -v '^#' "$1" | sed '/^[[:space:]]*$/d' | head -n 1)
case "$first" in
	"Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac
if printf '%s\n' "$first" | grep -qE '^[A-Za-z0-9_-]+(\([^()[:space:]][^()]*\))?: [^[:space:]]'; then
	exit 0
fi
echo "commit-msg: the first line must be 'type: subject' or 'type(scope): subject'" >&2
echo "  e.g. 'fix: ...' or 'feat(weapons): ...'" >&2
echo "  got: '$first'" >&2
exit 1
